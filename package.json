    "expo-document-picker": "^14.0.8",
    "expo-file-system": "^19.0.21",
    "expo-font": "~14.0.11",
    "expo-glass-effect": "~0.1.8",
    "expo-linking": "^8.0.11",
    "expo-localization": "~17.0.8",
    "expo-media-library": "~18.2.1",
    "expo-sharing": "~14.0.8",
    "expo-symbols": "~1.0.8",
    "file-picker": "file:./modules/file-picker",
    "folder-picker": "file:./modules/folder-picker",
