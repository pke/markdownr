default_platform(:ios)

APP_IDENTIFIER = "dev.dudesoft.markdownr"
PROJECT_ROOT = File.expand_path("..", __dir__)

def asc_api_key
  %w[APP_STORE_CONNECT_API_KEY_KEY_ID APP_STORE_CONNECT_API_KEY_ISSUER_ID APP_STORE_CONNECT_API_KEY_KEY_FILEPATH].each do |var|
    UI.user_error!("Missing required environment variable: #{var}") if ENV[var].to_s.empty?
  end
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
    key_filepath: ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"]
  )
end

def read_version
  props = File.read(File.join(PROJECT_ROOT, "version.properties"))
  major = props[/VERSION_MAJOR=(\d+)/, 1].to_i
  minor = props[/VERSION_MINOR=(\d+)/, 1].to_i
  patch = props[/VERSION_PATCH=(\d+)/, 1].to_i
  {
    version: "#{major}.#{minor}.#{patch}",
    build_number: (major * 10000 + minor * 100 + patch).to_s
  }
end

platform :ios do

  desc "Answer the age-rating questionnaire (incl. the 2026 social-media questions)"
  lane :update_age_rating do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: asc_api_key)
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    app_info = app.fetch_edit_app_info || app.fetch_live_app_info
    declaration = app_info.fetch_age_rating_declaration
    # Markdownr is a fully offline, read-only viewer: no social features.
    # The raw PATCH passes attributes straight through, so keys newer than
    # this fastlane's Spaceship model (socialMedia*) still apply.
    declaration.update(attributes: {
      "socialMedia" => false,
      "socialMediaAgeRestricted" => false
    })
    UI.success("Age rating: social-media questions answered (no social features)")
  rescue Spaceship::UnexpectedResponse => e
    # Not editable while a version sits in App Store review — the release lane
    # retries this at the right moment (before submission).
    UI.important("Age rating not updatable right now: #{e.message}")
  end

  desc "Upload metadata to App Store Connect (without screenshots)"
  lane :upload_metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      skip_screenshots: true,
      skip_binary_upload: true,
      force: true,
      precheck_include_in_app_purchases: false,
      automatic_release: true,
      phased_release: false
    )
  end

  desc "Submit the current version for App Store review"
  lane :submit_review do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      skip_metadata: true,
      skip_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: true,
      force: true,
      precheck_include_in_app_purchases: false,
      automatic_release: true,
      phased_release: false
    )
  end

  desc "Build and upload to TestFlight"
  lane :upload_beta do
    sh("cd #{PROJECT_ROOT} && npx expo prebuild --clean 2>&1")
    build_app(
      workspace: File.join(PROJECT_ROOT, "ios/Markdownr.xcworkspace"),
      scheme: "Markdownr",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: "K9VADMGRA7",
      output_directory: File.join(PROJECT_ROOT, "ios/build"),
      xcargs: "-allowProvisioningUpdates"
    )
    pilot(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      # External distribution keeps the public TestFlight link alive: the link
      # closes itself ("not accepting new testers") whenever the group has no
      # unexpired build. Requires waiting for processing + a changelog.
      distribute_external: true,
      groups: ["Public Beta"],
      changelog: File.read("metadata/en-GB/release_notes.txt"),
      skip_waiting_for_build_processing: false
    )
  end

  desc "Upload screenshots to App Store Connect"
  lane :upload_screenshots do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      skip_metadata: true,
      skip_binary_upload: true,
      force: true,
      overwrite_screenshots: true
    )
  end

  desc "Generate release notes from git commits since last tag. Review and edit before running release."
  lane :generate_release_notes do
    v = read_version
    version = v[:version]

    # Find the previous tag to get commits since last release
    tags = sh("git tag --sort=-version:refname -l 'v*'", log: false).strip.split("\n")
    if tags.length >= 2
      prev_tag = tags[1] # Second most recent tag (current release tag is first)
      commits = sh("git log #{prev_tag}..HEAD --pretty=format:'- %s' --no-merges", log: false).strip
    elsif tags.length == 1
      commits = sh("git log #{tags[0]}..HEAD --pretty=format:'- %s' --no-merges", log: false).strip
      commits = sh("git log --pretty=format:'- %s' --no-merges", log: false).strip if commits.empty?
    else
      commits = sh("git log --pretty=format:'- %s' --no-merges", log: false).strip
    end

    # Filter to only version-bumping commits (feat, fix, perf, refactor)
    meaningful = commits.split("\n").select { |line|
      line =~ /^- (feat|fix|perf|refactor)(\(.+?\))?[!]?:/i
    }.join("\n")

    meaningful = commits if meaningful.empty? # Fall back to all commits

    UI.header("Commits for v#{version} release notes")
    UI.message(meaningful)
    UI.message("")
    UI.important("Write release notes in:")
    UI.message("  fastlane/metadata/en-GB/release_notes.txt")
    UI.message("  fastlane/metadata/de-DE/release_notes.txt")
    UI.message("")
    UI.important("Then run: bundle exec fastlane ios release")
  end

  desc "Full release: prebuild, build, upload to TestFlight, upload metadata, and submit for review"
  lane :release do
    v = read_version
    version = v[:version]
    build_number = v[:build_number]

    UI.header("Releasing Markdownr v#{version} (build #{build_number})")

    # Verify release notes exist and aren't empty
    %w[en-GB de-DE].each do |locale|
      notes_path = "metadata/#{locale}/release_notes.txt"
      UI.user_error!("Missing release notes: #{notes_path}") unless File.exist?(notes_path)
      content = File.read(notes_path).strip
      UI.user_error!("Empty release notes: #{notes_path}") if content.empty?
    end

    # Verify git is clean
    status = sh("git status --porcelain", log: false).strip
    unless status.empty?
      UI.user_error!("Git working directory is not clean. Commit or stash changes first.\n#{status}")
    end

    # Step 1: Expo prebuild for production
    UI.header("Step 1/5: Expo prebuild")
    Dir.chdir(PROJECT_ROOT) do
      sh("npx expo prebuild --clean 2>&1")
    end

    # Step 2: Build
    UI.header("Step 2/5: Building Markdownr v#{version}")
    build_app(
      workspace: File.join(PROJECT_ROOT, "ios/Markdownr.xcworkspace"),
      scheme: "Markdownr",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: "K9VADMGRA7",
      output_directory: File.join(PROJECT_ROOT, "ios/build"),
      xcargs: "-allowProvisioningUpdates"
    )

    # Step 3: Upload to TestFlight (internal + Public Beta, so the public
    # link stays open — it closes when the group has no unexpired build)
    UI.header("Step 3/5: Uploading to TestFlight")
    pilot(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      distribute_external: true,
      groups: ["Public Beta"],
      changelog: File.read("metadata/en-GB/release_notes.txt"),
      skip_waiting_for_build_processing: false
    )

    # Step 4: Upload metadata, answer the age-rating questionnaire while the
    # new version's app info is editable, then submit for review
    UI.header("Step 4/5: Uploading metadata")
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false
    )

    update_age_rating

    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      skip_metadata: true,
      skip_screenshots: true,
      skip_binary_upload: true,
      force: true,
      submit_for_review: true,
      automatic_release: true,
      phased_release: false,
      precheck_include_in_app_purchases: false
    )

    # Step 5: Done
    UI.header("Step 5/5: Complete!")
    UI.success("Markdownr v#{version} (build #{build_number}) submitted for review!")
  end

  error do |lane, exception|
    UI.error("Lane #{lane} failed with error: #{exception.message}")
  end
end
