default_platform(:ios)

APP_IDENTIFIER = "dev.dudesoft.markdownr"

def asc_api_key
  %w[APP_STORE_CONNECT_API_KEY_KEY_ID APP_STORE_CONNECT_API_KEY_ISSUER_ID APP_STORE_CONNECT_API_KEY_KEY_FILEPATH].each do |var|
    UI.user_error!("Missing required environment variable: #{var}") if ENV[var].to_s.empty?
  end
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
    key_filepath: ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"]
  )
end

platform :ios do

  desc "Upload metadata to App Store Connect (without screenshots)"
  lane :upload_metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      skip_screenshots: true,
      skip_binary_upload: true,
      force: true,
      precheck_include_in_app_purchases: false,
      automatic_release: true,
      phased_release: false
    )
  end

  desc "Build and upload to TestFlight"
  lane :upload_beta do
    build_app(
      workspace: "ios/Markdownr.xcworkspace",
      scheme: "Markdownr",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: "K9VADMGRA7",
      output_directory: "ios/build",
      xcargs: "-allowProvisioningUpdates"
    )
    pilot(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload screenshots to App Store Connect"
  lane :upload_screenshots do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      skip_metadata: true,
      skip_binary_upload: true,
      force: true,
      overwrite_screenshots: true
    )
  end

  error do |lane, exception|
    UI.error("Lane #{lane} failed with error: #{exception.message}")
  end
end
