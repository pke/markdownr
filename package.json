  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^54.0.10",
    "canvas": "^3.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "lint-staged": "^16.2.7",
    "patch-package": "^8.0.1",
